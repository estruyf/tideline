{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tideline",
  "version": "0.1.0",
  "identifier": "be.eliostruyf.tideline",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tideline",
        "width": 620,
        "height": 720,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Keeps Downloads tidy.",
    "longDescription": "Today's files stay loose in the root where you expect them. Everything older gets filed into a folder named for the day it was downloaded.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  }
}
