[
  {
    "name": "yesterday is filed, today is left loose",
    "now": "2026-08-19T09:00:00",
    "config": {},
    "entries": [
      { "name": "invoice.pdf", "stamp": "2026-08-18T14:02:00" },
      { "name": "report.pdf", "stamp": "2026-08-19T08:55:00" }
    ],
    "expected": [{ "name": "invoice.pdf", "target_folder": "2026-08-18" }]
  },
  {
    "name": "a file from just before midnight belongs to the day it arrived",
    "now": "2026-08-19T00:05:00",
    "config": {},
    "entries": [{ "name": "late.zip", "stamp": "2026-08-18T23:59:00" }],
    "expected": [{ "name": "late.zip", "target_folder": "2026-08-18" }]
  },
  {
    "name": "the grace window keeps the last three days loose",
    "now": "2026-08-19T09:00:00",
    "config": { "keep_recent_days": 3 },
    "entries": [
      { "name": "day-4.pdf", "stamp": "2026-08-15T10:00:00" },
      { "name": "day-3.pdf", "stamp": "2026-08-16T10:00:00" },
      { "name": "day-2.pdf", "stamp": "2026-08-17T10:00:00" },
      { "name": "day-1.pdf", "stamp": "2026-08-18T10:00:00" }
    ],
    "expected": [{ "name": "day-4.pdf", "target_folder": "2026-08-15" }]
  },
  {
    "name": "monthly folders group a whole month together",
    "now": "2026-08-19T09:00:00",
    "config": { "folder_format": "monthly" },
    "entries": [
      { "name": "a.pdf", "stamp": "2026-07-02T10:00:00" },
      { "name": "b.pdf", "stamp": "2026-07-29T10:00:00" },
      { "name": "c.pdf", "stamp": "2026-08-01T10:00:00" }
    ],
    "expected": [
      { "name": "a.pdf", "target_folder": "2026-07" },
      { "name": "b.pdf", "target_folder": "2026-07" },
      { "name": "c.pdf", "target_folder": "2026-08" }
    ]
  },
  {
    "name": "a type rule decides where, never when",
    "now": "2026-08-19T09:00:00",
    "config": {
      "type_rules": [
        { "id": "installers", "name": "Installers", "extensions": ["msi", "exe"], "isEnabled": true, "isBuiltIn": true }
      ]
    },
    "entries": [
      { "name": "old-setup.msi", "stamp": "2026-08-17T10:00:00" },
      { "name": "todays-setup.msi", "stamp": "2026-08-19T08:00:00" },
      { "name": "notes.pdf", "stamp": "2026-08-17T10:00:00" }
    ],
    "expected": [
      { "name": "notes.pdf", "target_folder": "2026-08-17" },
      { "name": "old-setup.msi", "target_folder": "Installers", "is_by_type": true }
    ]
  },
  {
    "name": "a rule that is switched off does not claim anything",
    "now": "2026-08-19T09:00:00",
    "config": {
      "type_rules": [
        { "id": "installers", "name": "Installers", "extensions": ["msi"], "isEnabled": false, "isBuiltIn": true }
      ]
    },
    "entries": [{ "name": "setup.msi", "stamp": "2026-08-17T10:00:00" }],
    "expected": [{ "name": "setup.msi", "target_folder": "2026-08-17" }]
  },
  {
    "name": "the folders we made are never filed away",
    "now": "2026-08-19T09:00:00",
    "config": {
      "type_rules": [
        { "id": "installers", "name": "Installers", "extensions": ["msi"], "isEnabled": true, "isBuiltIn": true }
      ]
    },
    "entries": [
      { "name": "2026-08-17", "is_dir": true, "stamp": "2026-08-17T10:00:00" },
      { "name": "2026-08", "is_dir": true, "stamp": "2026-08-17T10:00:00" },
      { "name": "Installers", "is_dir": true, "stamp": "2026-08-17T10:00:00" },
      { "name": "2026-08-17-holiday", "is_dir": true, "stamp": "2026-08-17T10:00:00" }
    ],
    "expected": [
      { "name": "2026-08-17-holiday", "target_folder": "2026-08-17" }
    ]
  },
  {
    "name": "partial downloads and anything still being written stay put",
    "now": "2026-08-19T09:00:00",
    "config": {},
    "entries": [
      { "name": "big.iso.crdownload", "stamp": "2026-08-17T10:00:00" },
      { "name": "half.part", "stamp": "2026-08-17T10:00:00" },
      { "name": "notes.tmp", "stamp": "2026-08-17T10:00:00" },
      { "name": "slow.iso", "stamp": "2026-08-17T10:00:00", "settled": false },
      { "name": "done.iso", "stamp": "2026-08-17T10:00:00" }
    ],
    "expected": [{ "name": "done.iso", "target_folder": "2026-08-17" }]
  },
  {
    "name": "hidden entries are invisible to filing",
    "now": "2026-08-19T09:00:00",
    "config": {},
    "entries": [
      { "name": "desktop.ini", "stamp": "2026-08-17T10:00:00", "hidden": true },
      { "name": "visible.pdf", "stamp": "2026-08-17T10:00:00" }
    ],
    "expected": [{ "name": "visible.pdf", "target_folder": "2026-08-17" }]
  },
  {
    "name": "the skip list takes exact names and globs",
    "now": "2026-08-19T09:00:00",
    "config": { "skip_names": ["Inbox", "*.iso", "draft-?.docx"] },
    "entries": [
      { "name": "Inbox", "is_dir": true, "stamp": "2026-08-17T10:00:00" },
      { "name": "ubuntu.iso", "stamp": "2026-08-17T10:00:00" },
      { "name": "draft-3.docx", "stamp": "2026-08-17T10:00:00" },
      { "name": "draft-30.docx", "stamp": "2026-08-17T10:00:00" },
      { "name": "keep.pdf", "stamp": "2026-08-17T10:00:00" }
    ],
    "expected": [
      { "name": "draft-30.docx", "target_folder": "2026-08-17" },
      { "name": "keep.pdf", "target_folder": "2026-08-17" }
    ]
  },
  {
    "name": "folders move like files unless that is switched off",
    "now": "2026-08-19T09:00:00",
    "config": { "include_folders": false },
    "entries": [
      { "name": "holiday-pics", "is_dir": true, "stamp": "2026-08-17T10:00:00" },
      { "name": "notes.pdf", "stamp": "2026-08-17T10:00:00" }
    ],
    "expected": [{ "name": "notes.pdf", "target_folder": "2026-08-17" }]
  },
  {
    "name": "an entry with no readable date is left alone",
    "now": "2026-08-19T09:00:00",
    "config": {},
    "entries": [
      { "name": "mystery.pdf", "stamp": null },
      { "name": "ordinary.pdf", "stamp": "2026-08-17T10:00:00" }
    ],
    "expected": [{ "name": "ordinary.pdf", "target_folder": "2026-08-17" }]
  },
  {
    "name": "only the last extension counts",
    "now": "2026-08-19T09:00:00",
    "config": {
      "type_rules": [
        { "id": "archives", "name": "Archives", "extensions": ["gz"], "isEnabled": true, "isBuiltIn": true }
      ]
    },
    "entries": [{ "name": "backup.tar.gz", "stamp": "2026-08-17T10:00:00" }],
    "expected": [{ "name": "backup.tar.gz", "target_folder": "Archives", "is_by_type": true }]
  }
]
