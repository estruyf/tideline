.DS_Store
app/.build/
app/dist/
node_modules/
old-scripts/

# Windows build (windows/)
#
# `**/target/` rather than a fixed path: cargo drops a target directory beside
# whichever manifest it was invoked with, so a run from inside the core crate
# makes a second one the anchored pattern would miss.
windows/**/target/
windows/node_modules/

# Generated by tauri-build on every compile, from tauri.conf.json and the
# capabilities. Cargo.lock and package-lock.json are deliberately *not* here:
# this ships as a binary, so both belong in the repo.
windows/src-tauri/gen/schemas/

# Downloaded by the bundler when it builds an MSI.
windows/src-tauri/WixTools/
windows/src-tauri/NsisTools/

# Debug symbols, and rustfmt's backups.
*.pdb
*.rs.bk
